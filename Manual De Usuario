📜 Guía Rápida: Instagram Comment Scraper v3.0
Pasos a seguir:

Abre la publicación del sorteo en Instagram desde tu PC.

Presiona F12 (o clic derecho > Inspeccionar) y ve a la pestaña Consola.

Pega el código JavaScript y presiona Enter. (el codigo al final)

Espera sin cerrar la pestaña. El script hará scroll y leerá todo automáticamente.

Al terminar, se descargará solo el archivo comentarios_sorteo.json.

Detalles clave:

Más comentarios = Más chances: Cada comentario se guarda como una entrada individual en el JSON.

Anti-bloqueo: El código hace pausas aleatorias de 2 a 5 segundos para simular uso humano y proteger tu cuenta.

Copia tola la linea de abajo and enjoy :D

/*** ============================================* INSTAGRAM COMMENT SCRAPER v3.0 - CHANCES PROPORCIONALES* ============================================*/(function() {'use strict';const CONFIG = {MIN_DELAY: 2000,MAX_DELAY: 5000,SCROLL_AMOUNT: 800,DEBUG: true};const Utils = {randomDelay: () => {const delay = Math.floor(Math.random() * (CONFIG.MAX_DELAY - CONFIG.MIN_DELAY + 1)) + CONFIG.MIN_DELAY;return new Promise(resolve => setTimeout(resolve, delay));},log: (msg, type = 'info') => {if (!CONFIG.DEBUG) return;const timestamp = new Date().toLocaleTimeString();const styles = { info: 'color: #00d4ff', warn: 'color: #ffaa00', success: 'color: #00ff88', error: 'color: #ff0055' };console.log(`%c[${timestamp}] [SCRAPER] ${msg}`, styles[type] || styles.info);}};const CommentExtractor = {comments: [],seenIds: new Set(),noNewCommentsCount: 0,isRunning: false,findCommentsContainer: () => {const selectors = ['article section:nth-child(2) ul','article ul[role="list"]','article div[role="dialog"] ul','article div[style*="overflow"] ul','div[role="dialog"] article ul','section main article ul',];for (const selector of selectors) {const container = document.querySelector(selector);if (container) { Utils.log(`Contenedor: ${selector}`, 'success'); return container; }}const allLists = document.querySelectorAll('article ul, article ol');for (const list of allLists) {if (list.textContent.includes('Cargar') || list.querySelector('svg')) return list;}return null;},findLoadMoreButton: () => {const textButtons = Array.from(document.querySelectorAll('button, span, div[role="button"]'));for (const btn of textButtons) {const text = btn.textContent.toLowerCase().trim();if (text.includes('cargar más') || text.includes('load more') || text.includes('ver más') || text.includes('more comments')) return btn;}const svgs = document.querySelectorAll('svg');for (const svg of svgs) {const parent = svg.closest('button, div[role="button"], span[role="button"]');if (parent) {const ariaLabel = svg.getAttribute('aria-label') || '';const parentText = parent.textContent.toLowerCase();if (ariaLabel.includes('load') || ariaLabel.includes('more') || parentText.includes('cargar')) return parent;}}const ariaButtons = document.querySelectorAll('[aria-label*="cargar"], [aria-label*="load"], [aria-label*="more"]');for (const btn of ariaButtons) {if (btn.tagName === 'BUTTON' || btn.getAttribute('role') === 'button') return btn;}return null;},generateCommentId: (username, commentText) => {let hash = 0;const str = (username + '|' + commentText).toLowerCase();for (let i = 0; i < str.length; i++) {const char = str.charCodeAt(i);hash = ((hash << 5) - hash) + char;hash = hash & hash;}return username.toLowerCase() + '_' + Math.abs(hash);},extractCommentData: (element) => {try {const profileLink = element.querySelector('a[href^="/"]') || element.querySelector('a[role="link"]');let username = 'unknown';if (profileLink) {const href = profileLink.getAttribute('href');if (href && href.startsWith('/')) username = href.split('/')[1] || 'unknown';const linkText = profileLink.textContent.trim();if (linkText && linkText !== '' && !linkText.includes(' ')) username = linkText;}let commentText = '';const possibleTextContainers = element.querySelectorAll('span, div');for (const span of possibleTextContainers) {const text = span.textContent.trim();if (text && text !== username && !text.includes('Responder') && !text.includes('Reply') &&!text.includes('Me gusta') && !text.includes('Like') && span.children.length <= 3 && span !== profileLink) {if (span.tagName === 'SPAN' || (span.tagName === 'DIV' && !span.querySelector('button'))) {commentText = text; break;}}}if (!commentText) {const allSpans = element.querySelectorAll('span');for (const span of allSpans) {const text = span.textContent.trim();if (text && text !== username && text.length > 2) { commentText = text; break; }}}return { username, commentText };} catch (e) { return null; }},parseVisibleComments: () => {const container = CommentExtractor.findCommentsContainer();if (!container) { Utils.log('No se encontró contenedor', 'error'); return; }const commentElements = container.querySelectorAll('li, div[role="listitem"], article > div');let newComments = 0;for (const element of commentElements) {const data = CommentExtractor.extractCommentData(element);if (data && data.username !== 'unknown' && data.commentText) {const commentId = CommentExtractor.generateCommentId(data.username, data.commentText);if (!CommentExtractor.seenIds.has(commentId)) {CommentExtractor.seenIds.add(commentId);CommentExtractor.comments.push({username: data.username,comment: data.commentText,timestamp: new Date().toISOString(),id: commentId});newComments++;}}}if (newComments > 0) {Utils.log(`Nuevos: ${newComments} | Total: ${CommentExtractor.comments.length}`, 'success');CommentExtractor.noNewCommentsCount = 0;} else {CommentExtractor.noNewCommentsCount++;Utils.log(`Sin nuevos (${CommentExtractor.noNewCommentsCount} intentos)`, 'warn');}},scrollCommentsContainer: async () => {const container = CommentExtractor.findCommentsContainer();if (!container) return false;const previousScrollTop = container.scrollTop;container.scrollTop += CONFIG.SCROLL_AMOUNT;window.scrollBy(0, CONFIG.SCROLL_AMOUNT);await Utils.randomDelay();return container.scrollTop > previousScrollTop;},clickLoadMore: async () => {const button = CommentExtractor.findLoadMoreButton();if (button) {Utils.log('Click en "Cargar más"...', 'info');button.scrollIntoView({ behavior: 'smooth', block: 'center' });await Utils.randomDelay();button.click();await Utils.randomDelay();return true;}return false;},run: async () => {if (CommentExtractor.isRunning) { Utils.log('Ya en ejecución', 'warn'); return; }CommentExtractor.isRunning = true;Utils.log('🚀 INICIANDO EXTRACCIÓN (Chances Proporcionales)', 'success');Utils.log('Cada comentario = 1 entrada. Más comentarios = más chances.', 'info');let iterations = 0;const maxNoNewComments = 5;try {while (CommentExtractor.noNewCommentsCount < maxNoNewComments) {iterations++;Utils.log(`--- Iteración #${iterations} ---`, 'info');const clicked = await CommentExtractor.clickLoadMore();if (!clicked) {const scrolled = await CommentExtractor.scrollCommentsContainer();if (!scrolled && CommentExtractor.noNewCommentsCount >= 3) {Utils.log('Fin del contenido. Finalizando.', 'success'); break;}}CommentExtractor.parseVisibleComments();await Utils.randomDelay();}Utils.log('✅ EXTRACCIÓN COMPLETADA', 'success');const userCounts = {};CommentExtractor.comments.forEach(c => { userCounts[c.username] = (userCounts[c.username] || 0) + 1; });Utils.log(`Total entradas: ${CommentExtractor.comments.length}`, 'success');Utils.log(`Usuarios únicos: ${Object.keys(userCounts).length}`, 'success');const sorted = Object.entries(userCounts).sort((a, b) => b[1] - a[1]).slice(0, 5);Utils.log('🏆 Top participantes (más comentarios = más chances):', 'info');sorted.forEach(([user, count], i) => {console.log(` ${i + 1}. @${user}: ${count} comentarios (${((count / CommentExtractor.comments.length) * 100).toFixed(1)}%)`);});CommentExtractor.exportResults();} catch (error) {Utils.log(`❌ Error: ${error.message}`, 'error');console.error(error);CommentExtractor.exportResults();} finally { CommentExtractor.isRunning = false; }},exportResults: () => {const data = CommentExtractor.comments;if (data.length === 0) { Utils.log('No se extrajo nada.', 'error'); return; }const jsonData = JSON.stringify(data, null, 2);const blob = new Blob([jsonData], { type: 'application/json' });const url = URL.createObjectURL(blob);const a = document.createElement('a');a.href = url; a.download = 'comentarios_sorteo.json';document.body.appendChild(a); a.click();document.body.removeChild(a); URL.revokeObjectURL(url);Utils.log(`📥 Descargado: comentarios_sorteo.json (${data.length} entradas)`, 'success');console.table(data.slice(0, 10));if (data.length > 10) console.log(`... y ${data.length - 10} más`);}};Utils.log('Esperando 3 segundos...', 'info');setTimeout(() => { CommentExtractor.run(); }, 3000);})();
